rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function anonymous() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function hasRole(role) {
      return signedIn() && !anonymous() &&
        exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == role;
    }
    function admin() { return hasRole('admin'); }
    function teacher() { return hasRole('teacher'); }
    function student() { return anonymous(); }
    function member() { return student() || teacher() || admin(); }
    function staff() { return teacher() || admin(); }
    // A device link is immutable and only created atomically with a consumed invitation.
    function studentProfileId() {
      return exists(/databases/$(database)/documents/studentDevices/$(request.auth.uid))
        ? get(/databases/$(database)/documents/studentDevices/$(request.auth.uid)).data.studentId
        : request.auth.uid;
    }
    match /studentPairings/{token} {
      allow get: if student();
      allow create: if student() && token.matches('[a-f0-9]{64}') &&
        request.resource.data.keys().hasOnly(['studentId','issuer','createdAt','claimedBy']) &&
        request.resource.data.issuer == request.auth.uid &&
        request.resource.data.studentId == request.auth.uid &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        !exists(/databases/$(database)/documents/studentDevices/$(request.auth.uid)) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.claimedBy == null;
      allow update: if student() && resource.data.claimedBy == null &&
        request.time < resource.data.createdAt + duration.value(30, 's') &&
        request.auth.uid != resource.data.issuer &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy']) &&
        request.resource.data.claimedBy == request.auth.uid &&
        !exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        !exists(/databases/$(database)/documents/studentDevices/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
        getAfter(/databases/$(database)/documents/studentDevices/$(request.auth.uid)).data.token == token &&
        getAfter(/databases/$(database)/documents/studentDevices/$(request.auth.uid)).data.studentId == resource.data.studentId;
    }
    match /studentDevices/{uid} {
      allow get: if student() && (uid == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create: if student() && uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['studentId','token']) &&
        request.resource.data.token is string &&
        !exists(/databases/$(database)/documents/students/$(uid)) &&
        get(/databases/$(database)/documents/studentPairings/$(request.resource.data.token)).data.claimedBy == null &&
        getAfter(/databases/$(database)/documents/studentPairings/$(request.resource.data.token)).data.claimedBy == uid &&
        getAfter(/databases/$(database)/documents/studentPairings/$(request.resource.data.token)).data.studentId == request.resource.data.studentId;
      allow delete: if student() && (uid == request.auth.uid || resource.data.studentId == request.auth.uid);
    }
    match /teacherRequests/{uid} {
      allow create: if signedIn() && !anonymous() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['name','email','createdAt','approved']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('.*@afk[.]no') &&
        request.resource.data.approved == false &&
        request.resource.data.createdAt == request.time;
      allow get: if signedIn() && request.auth.uid == uid;
    }
    match /teacherApprovalLocks/{teacherId} {
      allow get: if admin();
      allow delete: if admin() &&
        get(/databases/$(database)/documents/userRoles/$(resource.data.uid)).data.role == 'teacher' &&
        get(/databases/$(database)/documents/userRoles/$(resource.data.uid)).data.teacherId == teacherId &&
        !existsAfter(/databases/$(database)/documents/userRoles/$(resource.data.uid));
      allow create: if admin() &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid is string &&
        getAfter(/databases/$(database)/documents/userRoles/$(request.resource.data.uid)).data.teacherId == teacherId &&
        getAfter(/databases/$(database)/documents/userRoles/$(request.resource.data.uid)).data.role == 'teacher';
    }
    match /userRoles/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin();
      allow create: if admin() &&
        request.resource.data.keys().hasOnly(['role','teacherId']) &&
        request.resource.data.role == 'teacher' &&
        exists(/databases/$(database)/documents/teacherRequests/$(uid)) &&
        get(/databases/$(database)/documents/teacherRequests/$(uid)).data.approved == false &&
        request.resource.data.teacherId == get(/databases/$(database)/documents/teacherRequests/$(uid)).data.email &&
        existsAfter(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)) &&
        !exists(/databases/$(database)/documents/teacherApprovalLocks/$(request.resource.data.teacherId)) &&
        getAfter(/databases/$(database)/documents/teacherApprovalLocks/$(request.resource.data.teacherId)).data.uid == uid &&
        !existsAfter(/databases/$(database)/documents/teacherRequests/$(uid));
      allow update: if false;
      allow delete: if admin() && resource.data.role == 'teacher' &&
        !existsAfter(/databases/$(database)/documents/teacherApprovalLocks/$(resource.data.teacherId));
    }
    match /{collection}/{id} {
      allow read: if member() && collection in [
        'blockCourses','blockExams','classes','exams','holidays',
        'tentamens','lessonProgressPlanImports','lessonProgressPlans','schedules',
        'teacherHomework','teachers','students'
      ];
      allow write: if staff() && collection in [
        'blockCourses','blockExams','exams','lessonProgressPlanImports',
        'lessonProgressPlans','teacherHomework','teachers','students'
      ];
      allow write: if admin() && collection in ['classes','schedules','holidays','homework','teacherRequests'];
      allow read: if admin() && collection in ['homework','teacherRequests'];
    }
    match /settings/{id} {
      allow read: if member() && !(id in ['adminAccess','superAccess']);
      allow write: if false;
    }
    match /students/{uid} {
      allow create: if student() && uid == request.auth.uid && studentProfileId() == uid &&
        request.resource.data.keys().hasOnly(['name','classId','createdAt','selectedBlockCourses']) &&
        request.resource.data.name is string && request.resource.data.classId is string;
      allow update: if student() && uid == studentProfileId() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedBlockCourses']) &&
        request.resource.data.selectedBlockCourses is list;
    }
    match /homework/{id} {
      allow get: if student() && id.matches(studentProfileId() + '_.*') &&
        (resource == null || resource.data.studentId == studentProfileId());
      allow list: if student() && resource.data.studentId == studentProfileId();
      allow create: if student() && id.matches(studentProfileId() + '_.*') &&
        request.resource.data.studentId == studentProfileId();
      allow update: if student() && id.matches(studentProfileId() + '_.*') &&
        resource.data.studentId == studentProfileId() &&
        request.resource.data.studentId == studentProfileId();
      allow delete: if student() && resource.data.studentId == studentProfileId();
    }
    match /exams/{id} {
      allow create: if student() && request.resource.data.teacher == false;
      allow update: if student() && resource.data.teacher == false &&
        request.resource.data.teacher == false;
      allow delete: if student() && resource.data.teacher == false;
    }
    match /blockExams/{id} {
      allow create: if student() && request.resource.data.teacher == false;
      allow update: if student() && resource.data.teacher == false &&
        request.resource.data.teacher == false;
      allow delete: if student() && resource.data.teacher == false;
    }
  }
}
